# Nome da sua agência/marca (aparece no topo do dashboard e nos relatórios)
NEXT_PUBLIC_APP_BRAND_NAME=Assertivus Dash

# Token de System User da Meta (não expira)
META_ACCESS_TOKEN=EAAG...

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Assertivus IA — OpenCode Go é recomendado pelo custo-benefício do seu caso.
# Não exponha essas chaves em variáveis NEXT_PUBLIC_*.
OPENCODE_GO_API_KEY=sk-...
OPENCODE_GO_MODEL_FAST=deepseek-v4-flash
OPENCODE_GO_MODEL_ANALYSIS=deepseek-v4-flash
OPENCODE_GO_MODEL_STRATEGIC=qwen3.7-plus
OPENCODE_GO_MODEL_CREATIVE=qwen3.7-plus

# OpenCode Zen pay-as-you-go opcional: fallback quando não houver Go.
OPENCODE_ZEN_API_KEY=sk-...
OPENCODE_MODEL_FAST=gpt-5.6-luna
OPENCODE_MODEL_ANALYSIS=gpt-5.6-terra
OPENCODE_MODEL_STRATEGIC=gpt-5.6-sol
OPENCODE_MODEL_CREATIVE=gpt-5.6-terra

# OpenRouter opcional: fallback e roteamento para modelos de outros provedores.
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL_FAST=openrouter/auto
OPENROUTER_MODEL_ANALYSIS=openrouter/auto
OPENROUTER_MODEL_STRATEGIC=openrouter/auto
OPENROUTER_MODEL_CREATIVE=openrouter/auto

# Google Ads (OAuth de usuário único + MCC, IDs sem hífens)
GOOGLE_ADS_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=GOCSPX-xxxx
GOOGLE_ADS_REFRESH_TOKEN=1//xxxx
GOOGLE_ADS_DEVELOPER_TOKEN=xxxx
GOOGLE_ADS_LOGIN_CUSTOMER_ID=1234567890

# Google Drive (usa o mesmo OAuth client; a conexão é iniciada pelo painel)
# Cadastre no Google Cloud o redirect URI:
# https://SEU_DOMINIO/api/integrations/google-drive/callback

# Segredo para proteger a rota de coleta (o Vercel Cron usa como Bearer)
CRON_SECRET=gere-uma-string-aleatoria-aqui

# Acesso pessoal ao dashboard (também configure na Vercel)
# Use uma senha forte (mín. 12 caracteres) e um segredo aleatório (mín. 32).
DASHBOARD_PASSWORD=troque-por-uma-senha-forte
SESSION_SECRET=gere-uma-string-aleatoria-com-32-ou-mais-caracteres

# Relatório semanal por e-mail (cron de segunda-feira, 0 11 * * 1)
# O domínio precisa estar verificado no Resend, senão só entrega para você.
RESEND_API_KEY=re_xxxx
REPORT_FROM_EMAIL=Sua Agência <relatorios@seudominio.com>
REPORT_REPLY_TO=voce@seudominio.com
# Para onde vai o modo de teste (?dry=1). Nunca chega no cliente.
REPORT_TEST_EMAIL=voce@seudominio.com
# Base usada nos links do e-mail (o cron não tem request para deduzir o host).
APP_URL=https://seuapp.vercel.app
# Assina os links públicos do relatório. Sem isso, cai no SESSION_SECRET.
REPORT_LINK_SECRET=gere-outra-string-aleatoria-com-32-ou-mais-caracteres

# Lembrete INTERNO de pendências (tarefas atrasadas/de hoje e projetos no prazo
# final). Sai junto da coleta diária e usa o mesmo REPORT_FROM_EMAIL.
# O mesmo e-mail recebe o relatório financeiro mensal, no último dia do mês.
# Este e-mail é seu, não do cliente. OBRIGATÓRIO — sem ele o envio falha.
TASK_ALERT_EMAIL=voce@seudominio.com

# Asaas (cobranças recorrentes dos clientes)
ASAAS_API_KEY=$aact_...
ASAAS_ENVIRONMENT=sandbox
ASAAS_WEBHOOK_TOKEN=gere-um-token-para-o-webhook
